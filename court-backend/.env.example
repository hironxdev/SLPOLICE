# ============================================================
# CCID Intelligence Suite — court-backend Environment Config
# Copy this file to .env and fill in your production values
# ============================================================

# Port the backend API will listen on (hosting providers set this automatically)
PORT=8000

# JWT Secret — MUST be changed to a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ccid-secure-secret-key-CHANGE-IN-PRODUCTION

# Allowed CORS origin — set to your frontend's domain in production
# Example: https://ccid.police.lk
# Use * only for local development
ALLOWED_ORIGIN=*
